			<EditBox name="AtlasLootSearchBox" inherits="InputBoxTemplate" letters="100" autoFocus="false">
				<Size x="248" y="32"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="AtlasLootWishListButton" relativePoint="RIGHT"><Offset x="10" y="0"/></Anchor>
				</Anchors>
				<TextInsets left="0" right="8" top="0" bottom="0"/>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="AtlasLootSearchBoxPrompt" inherits="GameFontDisableSmall" justifyH="LEFT">
							<Size x="0" y="20"/>
							<Anchors>
								<Anchor point="LEFT"><Offset x="0" y="0"/></Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						AtlasLootSearchBoxPrompt:SetText(AtlasLoot.L["Search loot"])
						AtlasLootClearSearchButton:SetAlpha(0.5)
						AtlasLootClearSearchButton:Disable()
					</OnLoad>
					<OnEnterPressed>
						AtlasLoot.Search(this:GetText())
						this:ClearFocus()
					</OnEnterPressed>
					<OnEscapePressed>
						-- this:SetText("")
						this:ClearFocus()
					</OnEscapePressed>
					<OnEditFocusGained>
						this:HighlightText()
						AtlasLootSearchBoxPrompt:Hide()
						AtlasLootClearSearchButton:SetAlpha(1)
						AtlasLootClearSearchButton:Enable()
					</OnEditFocusGained>
					<OnEditFocusLost>
						this:HighlightText(0, 0)
						if this:GetText() == "" then
							AtlasLootSearchBoxPrompt:Show()
							AtlasLootClearSearchButton:SetAlpha(0.5)
							AtlasLootClearSearchButton:SetButtonState("NORMAL")
							AtlasLootClearSearchButton:Disable()
						else
							AtlasLootClearSearchButton:SetAlpha(1)
							AtlasLootClearSearchButton:Enable()
						end
					</OnEditFocusLost>
					<OnTextChanged>
						if this:GetText() ~= "" then
							AtlasLootSearchBoxPrompt:Hide()
						end
					</OnTextChanged>
				</Scripts>
				<Frames>
					<Button name="AtlasLootSearchOptionsButton">
						<Size x="28" y="28"/>
						<Anchors>
							<Anchor point="LEFT" relativeTo="AtlasLootSearchBox" relativePoint="RIGHT"><Offset x="0" y="0"/></Anchor>
						</Anchors>
						<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
						<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
						<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
						<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
						<Scripts>
							<OnShow>
								this:SetFrameLevel(this:GetParent():GetFrameLevel() + 1)
							</OnShow>
							<OnClick>
								AtlasLoot.ShowSearchOptions(this)
							</OnClick>
							<OnEnter>
								GameTooltip:SetOwner(this, "ANCHOR_RIGHT", -(this:GetWidth() / 2), 0)
								GameTooltip:SetText(AtlasLoot.L["Search options"], 1, 1, 1)
							</OnEnter>
							<OnLeave>
								GameTooltip:Hide()
							</OnLeave>
						</Scripts>
					</Button>
					<Button name="AtlasLootLastResultButton" inherits="UIPanelButtonTemplate2">
						<Size x="100" y="21"/>
						<Anchors>
							<Anchor point="LEFT" relativeTo="AtlasLootSearchOptionsButton" relativePoint="RIGHT"/>
						</Anchors>
						<Scripts>
							<OnShow>
								this:SetText(AtlasLoot.L["Last Result"])
								this:SetFrameLevel(this:GetParent():GetFrameLevel() + 1)
							</OnShow>
							<OnEnter>
								GameTooltip:SetOwner(this, "ANCHOR_RIGHT", -(this:GetWidth() / 2), 0)
								GameTooltip:SetText(AtlasLoot.L["Last Result"], 1, 1, 1)
								GameTooltip:AddLine(AtlasLoot.L["Show results of the last search"])
								GameTooltip:Show()
							</OnEnter>
							<OnLeave>
								GameTooltip:Hide()
							</OnLeave>
							<OnClick>
								AtlasLoot.ShowSearchResult()
							</OnClick>
						</Scripts>
					</Button>
					<Button name="AtlasLootClearSearchButton" inherits="UIPanelCloseButton">
						<Size x="20" y="20"/>
						<Anchors>
							<Anchor point="RIGHT"><Offset x="-2" y="0"/></Anchor>
						</Anchors>
						<Scripts>
							<OnShow>
								this:SetFrameLevel(AtlasLootSearchBox:GetFrameLevel() + 3)
							</OnShow>
							<OnClick>
								AtlasLootSearchBox:SetText("")
								AtlasLootSearchBox:ClearFocus()
								AtlasLootSearchBoxPrompt:Show()
								AtlasLootClearSearchButton:SetButtonState("NORMAL")
								AtlasLootClearSearchButton:Disable()
								AtlasLootClearSearchButton:SetAlpha(0.5)
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</EditBox>
